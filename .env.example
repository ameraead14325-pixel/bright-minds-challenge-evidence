# ===== منصة سجل شواهد الأداء الوظيفي 1448هـ =====
# انسخي هذا الملف إلى .env (محليًا) أو أدخلي القيم في لوحة الاستضافة كمتغيرات بيئة.
# لا ترفعي ملف .env إلى أي مستودع عام.

# الرابط العام للمنصة بدون شرطة في النهاية (مثال: https://shawahid.example.com)
APP_URL=http://localhost:3000
PORT=3000

# من Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# بريد صاحبة المنصة (المعلمة) — الحساب الوحيد الذي يستطيع ربط Drive والتعديل
OWNER_EMAIL=

# (اختياري) بريد من يُسمح لهم بالاطلاع فقط، مفصولة بفواصل — مثل مديرة المدرسة
VIEWER_EMAILS=

# مفتاح تشفير رموز Google داخل قاعدة البيانات (32 بايت hex) — أنشئيه بالأمر: npm run gen-key
TOKEN_ENCRYPTION_KEY=

# مسار قاعدة البيانات (يجب أن يكون على قرص دائم في الاستضافة)
DATABASE_PATH=./data/shawahid.db

# حفظ حالة المنصة خارجيًا (مطلوب على الاستضافات بلا قرص دائم مثل خطة Render المجانية)
# من console.upstash.com > Redis > Create Database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (اختياري) لتفعيل التلخيص والاقتراح بنموذج ذكاء اصطناعي حقيقي (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
